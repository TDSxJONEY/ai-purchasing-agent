# Neon pooled connection — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Neon direct connection — used by Prisma for migrations / db push
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# OpenRouter (optional in replay mode)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"

# live = call OpenRouter | replay = use recorded fixtures (tests, offline demo)
AGENT_MODE="replay"

# Protects the seed/reset endpoint on the deployed app
ADMIN_SEED_TOKEN="change-me"
